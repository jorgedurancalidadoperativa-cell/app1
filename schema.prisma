generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum RoleName { ADMIN CASHIER }
enum SaleStatus { COMPLETED CANCELLED }
enum InventoryMovementType { ENTRY SALE POSITIVE_ADJUSTMENT NEGATIVE_ADJUSTMENT RETURN SALE_CANCELLATION }

model Role { id String @id @default(cuid()); name RoleName @unique; users User[] }
model Store { id String @id @default(cuid()); code String @unique; name String; address String?; phone String?; active Boolean @default(true); users User[]; sales Sale[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model User { id String @id @default(cuid()); name String; username String @unique; passwordHash String; active Boolean @default(true); roleId String; role Role @relation(fields:[roleId],references:[id]); storeId String?; store Store? @relation(fields:[storeId],references:[id]); sales Sale[]; movements InventoryMovement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Category { id String @id @default(cuid()); name String @unique; products Product[] }
model Supplier { id String @id @default(cuid()); name String; taxId String?; phone String?; email String?; address String?; active Boolean @default(true); products Product[]; entries InventoryEntry[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid()); barcode String @unique; name String; description String?; brand String?; unit String @default("PZA"); purchasePrice Decimal @db.Decimal(12,2); salePrice Decimal @db.Decimal(12,2); stock Decimal @db.Decimal(12,3) @default(0); minimumStock Decimal @db.Decimal(12,3) @default(0); active Boolean @default(true); imageUrl String?; categoryId String?; category Category? @relation(fields:[categoryId],references:[id]); supplierId String?; supplier Supplier? @relation(fields:[supplierId],references:[id]); saleItems SaleItem[]; entryItems EntryItem[]; movements InventoryMovement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model InventoryEntry { id String @id @default(cuid()); entryNumber String @unique; entryDate DateTime; supplierId String?; supplier Supplier? @relation(fields:[supplierId],references:[id]); reference String?; notes String?; items EntryItem[]; createdAt DateTime @default(now()) }
model EntryItem { id String @id @default(cuid()); entryId String; entry InventoryEntry @relation(fields:[entryId],references:[id],onDelete: Cascade); productId String; product Product @relation(fields:[productId],references:[id]); quantity Decimal @db.Decimal(12,3); purchasePrice Decimal @db.Decimal(12,2); amount Decimal @db.Decimal(12,2) }
model PaymentMethod { id String @id @default(cuid()); name String @unique; active Boolean @default(true); sales Sale[] }
model Sale { id String @id @default(cuid()); ticketNumber String @unique; soldAt DateTime @default(now()); userId String; user User @relation(fields:[userId],references:[id]); storeId String; store Store @relation(fields:[storeId],references:[id]); paymentMethodId String; paymentMethod PaymentMethod @relation(fields:[paymentMethodId],references:[id]); subtotal Decimal @db.Decimal(12,2); discount Decimal @db.Decimal(12,2); total Decimal @db.Decimal(12,2); cashReceived Decimal @db.Decimal(12,2) @default(0); changeGiven Decimal @db.Decimal(12,2) @default(0); status SaleStatus @default(COMPLETED); items SaleItem[]; cancellation Cancellation?; createdAt DateTime @default(now()) }
model SaleItem { id String @id @default(cuid()); saleId String; sale Sale @relation(fields:[saleId],references:[id],onDelete: Cascade); productId String; product Product @relation(fields:[productId],references:[id]); quantity Decimal @db.Decimal(12,3); unitPrice Decimal @db.Decimal(12,2); discount Decimal @db.Decimal(12,2); subtotal Decimal @db.Decimal(12,2) }
model InventoryMovement { id String @id @default(cuid()); productId String; product Product @relation(fields:[productId],references:[id]); movedAt DateTime @default(now()); quantity Decimal @db.Decimal(12,3); type InventoryMovementType; userId String; user User @relation(fields:[userId],references:[id]); reason String?; reference String? }
model Cancellation { id String @id @default(cuid()); saleId String @unique; sale Sale @relation(fields:[saleId],references:[id]); cancelledAt DateTime @default(now()); userId String; reason String }
model BusinessConfig { id String @id @default(cuid()); businessName String @default("Mi Negocio"); logoUrl String?; address String?; phone String?; email String?; taxId String?; receiptLegend String?; currency String @default("MXN"); taxEnabled Boolean @default(false); taxRate Decimal @db.Decimal(5,2) @default(0); allowNegativeInventory Boolean @default(false); defaultMinimumStock Decimal @db.Decimal(12,3) @default(0); updatedAt DateTime @updatedAt }